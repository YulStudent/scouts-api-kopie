[Gebruiker]
*gebruikerID {label: "int, PK"}
voornaam {label: "varchar, verplicht"}
achternaam {label: "varchar, verplicht"}
straatnaam {label: "varchar, verplicht"}
huisnummer {label: "varchar, verplicht"}
postcode {label: "varchar, verplicht"}
gemeente {label: "varchar, verplicht"}
gebruikerType {label: "discriminator: Lid, Ouder of Leiding"}
emailadres {label: "varchar, nullable"}
telefoonnummer {label: "varchar, nullable"}
rijksregisternummer {label: "varchar, nullable"}
heeftToestemmingFotos {label: "boolean, nullable"}
startdatumLeiding {label: "date, nullable, enkel Leiding"}
datumAccountcreatie {label: "datetime, verplicht"}

[Totem]
*totemID {label: "int, PK"}
#gebruikerID {label: "int, FK, unique"}
totem {label: "varchar, verplicht"}
voortotem {label: "varchar, nullable"}
plaats {label: "varchar, verplicht"}
jaar {label: "int, verplicht"}

[Lid_Ouder]
*lidGebruikerID
*ouderGebruikerID
relatie
isNoodcontact

[MedischeFiche]
*medischeFicheID
#gebruikerID {label: "int, FK, unique"}
naamHuisarts
telefoonnummerHuisarts
adresHuisarts
datumInentingTetanus
bloedgroep
allergieen
ziektes
beperkingen
dieet
aandachtspuntenSlapen
aandachtspuntenAlgemeen
opmerkingActiviteiten
datumLaatsteWijziging
datumToestemmingOuders

[Medicatie]
*medicatieID
#medischeFicheID
naamMedicatie
dosering
tijdstip
opmerking

[Tak]
*takID
takNaam
minimumLeeftijd
maximumLeeftijd
maximumAantalLedenGeboortejaar

[Lidmaatschap]
*gebruikerID {label: "int, PK, FK"}
*werkjaar {label: "int, PK"}
#takID {label: "int, FK, nullable"}
betaald {label: "boolean, verplicht"}
isTakleiding {label: "boolean, default false, enkel Leiding"}
isEenheidsleiding {label: "boolean, default false, enkel Leiding"}

Lid_Ouder *--1 Gebruiker {label: "lid"}
Lid_Ouder *--1 Gebruiker {label: "ouder"}
Totem ?--1 Gebruiker {label: "toebehorend aan"}
MedischeFiche ?--1 Gebruiker {label: "hoort bij"}
Medicatie *--1 MedischeFiche {label: "gebruikt volgens fiche"}
Lidmaatschap *--1 Gebruiker {label: "van"}
Lidmaatschap *--1 Tak {label: "in tak"}
