[Gebruiker]
*gebruikerID {label: "int, PK"}
voornaam {label: "varchar, verplicht"}
achternaam {label: "varchar, verplicht"}
straatnaam {label: "varchar, verplicht"}
huisnummer {label: "varchar, verplicht"}
postcode {label: "varchar, verplicht"}
gemeente {label: "varchar, verplicht"}
gebruikerType {label: "discriminator: Lid, Ouder of Leiding"}
emailadres {label: "varchar, nullable"}
telefoonnummer {label: "varchar, nullable"}
rijksregisternummer {label: "varchar, nullable"}
heeftToestemmingFotos {label: "boolean, nullable"}
startdatumLeiding {label: "date, enkel Leiding"}
datumAccountcreatie {label: "datetime, verplicht"}

[Lid_Ouder]
*lidGebruikerID
*ouderGebruikerID
relatie
isNoodcontact

[MedischeFiche]
*medischeFicheID
#gebruikerID
naamHuisArts
telefoonnummerHuisarts
adresHuisarts
inentingTetanusDatum
bloedgroep
allergieen
ziektes
beperkingen
dieet
aandachtpuntenSlapen
aandachtpuntenAlgemeen
opmerkingActiviteiten
datumLaatsteWijziging
datumToestemmingOuders

[Medicatie]
*medicatieID
#medischeFicheID
naamMedicatie
dosering
tijdstip
opmerking

[Lid_Patrouille]
*gebruikerID
*werkjaar
#patrouilleID
isAssistentPatrouilleLeider
isPatrouilleleider

[Patrouille]
*patrouilleID
patrouilleNaam
#takID
kreet

[Tak]
*takID
takNaam
minimumLeeftijd
maximumLeeftijd
maximumAantalLedenGeboortejaar

[Lidmaatschap]
*gebruikerID
*werkjaar
#takID
betaald

[Leiding_Werkjaar]
*gebruikerID
*werkjaar
#takID
isTakleiding
isEenheidsleiding

Lid_Ouder *--1 Gebruiker {label: "lid"}
Lid_Ouder *--1 Gebruiker {label: "ouder"}
MedischeFiche ?--1 Gebruiker {label: "hoort bij"}
Medicatie *--1 MedischeFiche {label: "gebruikt volgens fiche"}
Lid_Patrouille *--1 Gebruiker {label: "lid"}
Lid_Patrouille *--1 Patrouille {label: "zit in"}
Patrouille *--1 Tak {label: "hoort bij"}
Lidmaatschap *--1 Gebruiker {label: "van"}
Lidmaatschap *--1 Tak {label: "in tak"}
Leiding_Werkjaar *--1 Gebruiker {label: "leiding"}
Leiding_Werkjaar *--1 Tak {label: "begeleidt"}